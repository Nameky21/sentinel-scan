ZAP_HOST=127.0.0.1
ZAP_PORT=8080
ZAP_API_KEY=change-me
DATABASE_URL=sqlite:///./sentinelscan.db
CORS_ORIGINS=http://localhost:5173

# Scan time limits (minutes)
SPIDER_MAX_DURATION_MINS=2
AJAX_SPIDER_MAX_DURATION_MINS=3
ASCAN_MAX_DURATION_MINS=10

# Browser used by ZAP's AJAX spider to crawl JavaScript-rendered pages.
# Options include chrome-headless, firefox-headless, htmlunit.
AJAX_SPIDER_BROWSER=chrome-headless
